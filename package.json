{
  "name": "esscom-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/fix-static-segments.mjs",
    "start": "node scripts/serve-static.mjs",
    "preview": "node scripts/serve-static.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check:export": "node --import ./scripts/register-typescript.mjs scripts/check-export.mjs",
    "test": "node --import ./scripts/register-typescript.mjs --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:browser:install": "playwright install webkit",
    "measure:performance": "node scripts/measure-performance.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:indexing": "node scripts/check-indexing.mjs",
    "check:assets": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
